# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
POSTGRES_DB=ticketdesk
POSTGRES_USER=ticketdesk
POSTGRES_PASSWORD=ticketdesk
POSTGRES_HOST=db
POSTGRES_PORT=5432

# CORS — the Next.js dev server / deployed frontend origin(s), comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend host used to build client-facing links embedded in emails
FRONTEND_BASE_URL=http://localhost:3000

# Email — console backend in dev (prints to stdout); swap to SMTP in deployment
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=incidents@example.com
ADMIN_NOTIFICATION_EMAILS=admin@example.com
